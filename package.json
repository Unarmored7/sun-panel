    "build-only": "vite build",
    "type-check": "vue-tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "bootstrap": "pnpm install"
  },
  "dependencies": {
    "@traptitech/markdown-it-katex": "^3.6.0",
    "@vueuse/core": "^15.0.0",
    "highlight.js": "^11.12.0",
    "katex": "^0.19.0",
    "markdown-it": "^15.0.2",
    "moment": "^2.31.0",
    "naive-ui": "^2.45.3",
    "pinia": "^2.3.1",
    "vue": "^3.5.43",
    "vue-draggable-plus": "^0.6.1",
    "vue-i18n": "^11.4.14",
    "vue-router": "^4.6.4",
    "vuedraggable": "^4.1.0"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^9.5.1",
    "@iconify/vue": "^5.0.3",
    "@types/crypto-js": "^4.2.2",
    "@types/katex": "^0.16.8",
    "@types/node": "^24.19.2",
    "@vitejs/plugin-vue": "^6.0.10",
    "autoprefixer": "^10.6.1",
    "axios": "^1.20.0",
    "crypto-js": "^4.2.0",
    "eslint": "^10.12.0",
    "less": "^4.9.1",
    "npm-run-all": "^4.1.5",
    "postcss": "^8.5.29",
    "rimraf": "^6.1.3",
    "tailwindcss": "^3.4.19",
    "typescript": "~5.9.3",
    "vite": "^8.3.4",
    "vite-plugin-pwa": "^2.0.0",
    "vue-tsc": "^3.3.13"
  },
  "packageManager": "pnpm@8.15.9",
  "engines": {
    "node": ">=22 <25"
  },
  "pnpm": {
    "overrides": {
      "postcss-selector-parser": "^7.1.6",
      "katex": "^0.19.0"
    }
