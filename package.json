{
  "name": "usagi-navigation",
  "version": "1.3.0-usagi.1",
  "private": true,
  "description": "Usagi Navigation — a source-controlled Sun-Panel fork",
  "author": "BraisedHunter <95302870@qq.com>",
  "keywords": [
    "Sun-Panel",
    "vue"
  ],
  "scripts": {
    "dev": "vite",
    "build": "pnpm run add-version && run-p type-check build-only",
